views:
  - type: cards
    name: Movie Card View
    filters:
      and:
        - file.folder == "Movies"
    image: note.poster
    cardSize: 140
    imageAspectRatio: 1.5
  - type: table
    name: Book List View
    filters:
      and:
        - file.folder == "Novels"
    order:
      - file.name
      - goodreads score
      - status
      - tags
    sort:
      - property: goodreads score
        direction: ASC
    columnSize:
      file.name: 567
